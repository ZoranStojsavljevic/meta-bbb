From 6a2e3f60dc42fadd0a615d252059a39b1489f843 Mon Sep 17 00:00:00 2001
From: Zoran Stojsavljevic <zoran.stojsavljevic@gmail.com>
Date: Wed, 11 Jun 2025 06:29:30 +0200
Subject: [PATCH] Update DTS to remove cape I2C definitions

Upstream-Status: Pending

---
 .../boot/dts/ti/omap/am335x-bone-common.dtsi  | 76 -------------------
 1 file changed, 76 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/am335x-bone-common.dtsi b/arch/arm/boot/dts/ti/omap/am335x-bone-common.dtsi
index c400b7b70d0d..eefaa7b33699 100644
--- a/arch/arm/boot/dts/ti/omap/am335x-bone-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/am335x-bone-common.dtsi
@@ -82,13 +82,6 @@ AM33XX_PADCONF(AM335X_PIN_I2C0_SCL, PIN_INPUT_PULLUP, MUX_MODE0)	/* i2c0_scl.i2c
 		>;
 	};
 
-	i2c2_pins: i2c2-pins {
-		pinctrl-single,pins = <
-			AM33XX_PADCONF(AM335X_PIN_UART1_CTSN, PIN_INPUT_PULLUP, MUX_MODE3)	/* uart1_ctsn.i2c2_sda */
-			AM33XX_PADCONF(AM335X_PIN_UART1_RTSN, PIN_INPUT_PULLUP, MUX_MODE3)	/* uart1_rtsn.i2c2_scl */
-		>;
-	};
-
 	uart0_pins: uart0-pins {
 		pinctrl-single,pins = <
 			AM33XX_PADCONF(AM335X_PIN_UART0_RXD, PIN_INPUT_PULLUP, MUX_MODE0)
@@ -233,75 +226,6 @@ baseboard_data: baseboard_data@0 {
 	};
 };
 
-&i2c2 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&i2c2_pins>;
-
-	status = "okay";
-	clock-frequency = <100000>;
-
-	cape_eeprom0: eeprom@54 {
-		compatible = "atmel,24c256";
-		reg = <0x54>;
-
-		nvmem-layout {
-			compatible = "fixed-layout";
-			#address-cells = <1>;
-			#size-cells = <1>;
-
-			cape0_data: cape_data@0 {
-				reg = <0 0x100>;
-			};
-		};
-	};
-
-	cape_eeprom1: eeprom@55 {
-		compatible = "atmel,24c256";
-		reg = <0x55>;
-
-		nvmem-layout {
-			compatible = "fixed-layout";
-			#address-cells = <1>;
-			#size-cells = <1>;
-
-			cape1_data: cape_data@0 {
-				reg = <0 0x100>;
-			};
-		};
-	};
-
-	cape_eeprom2: eeprom@56 {
-		compatible = "atmel,24c256";
-		reg = <0x56>;
-
-		nvmem-layout {
-			compatible = "fixed-layout";
-			#address-cells = <1>;
-			#size-cells = <1>;
-
-			cape2_data: cape_data@0 {
-				reg = <0 0x100>;
-			};
-		};
-	};
-
-	cape_eeprom3: eeprom@57 {
-		compatible = "atmel,24c256";
-		reg = <0x57>;
-
-		nvmem-layout {
-			compatible = "fixed-layout";
-			#address-cells = <1>;
-			#size-cells = <1>;
-
-			cape3_data: cape_data@0 {
-				reg = <0 0x100>;
-			};
-		};
-	};
-};
-
-
 /include/ "../../tps65217.dtsi"
 
 &tps {
-- 
